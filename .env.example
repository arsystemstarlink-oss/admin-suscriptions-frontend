VITE_API_BASE_URL=http://localhost:3000/api

# URL de respaldo: si VITE_API_BASE_URL (servidor local) no responde,
# el frontend conmuta automáticamente a esta URL.
# Si no se define, se usa la API de producción de Railway.
# VITE_API_FALLBACK_URL=https://admin-suscriptions-backend-production.up.railway.app/api

# Opcional: si no se define, el frontend obtiene la clave pública VAPID
# desde GET /api/push/vapid-public-key
# Esta clave DEBE coincidir con VAPID_PUBLIC_KEY configurada en el backend
# (Railway → Servicio → Variables) para que las suscripciones push funcionen.
VITE_VAPID_PUBLIC_KEY=
