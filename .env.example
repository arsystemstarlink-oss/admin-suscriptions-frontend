VITE_API_BASE_URL=http://localhost:3000/api

# En desarrollo, Vite prueba primero VITE_API_BASE_URL y usa este respaldo
# automáticamente si la API local no está disponible.
# El proxy local evita depender de CORS para conectarse al servidor remoto.
VITE_API_FALLBACK_URL=https://admin-suscriptions-backend-production.up.railway.app/api

# Opcional: si no se define, el frontend obtiene la clave pública VAPID
# desde GET /api/push/vapid-public-key
# Esta clave DEBE coincidir con VAPID_PUBLIC_KEY configurada en el backend
# (Railway → Servicio → Variables) para que las suscripciones push funcionen.
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile (opcional). Si se define, el portal /consulta exige el
# CAPTCHA antes de consultar o reportar pagos. Debe coincidir con
# TURNSTILE_SECRET_KEY configurada en el backend.
VITE_TURNSTILE_SITE_KEY=

# Número internacional de WhatsApp, solo dígitos y código de país.
VITE_WHATSAPP_NUMBER=
