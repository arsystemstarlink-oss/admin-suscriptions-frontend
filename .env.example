VITE_API_BASE_URL=http://localhost:3000/api
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=12345678

# Opcional: si no se define, el frontend obtiene la clave pública VAPID
# desde GET /api/push/vapid-public-key
# Esta clave DEBE coincidir con VAPID_PUBLIC_KEY configurada en el backend
# (Railway → Servicio → Variables) para que las suscripciones push funcionen.
VITE_VAPID_PUBLIC_KEY=
